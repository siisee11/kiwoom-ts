{
  "name": "@jasset/kiwoom",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/siisee11/kiwoom-ts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "concurrently \"vite --config playground/vite.config.ts\" \"bun --watch playground/server.ts\"",
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "preview": "vite preview --config playground/vite.config.ts",
    "prepublishOnly": "npm run build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@types/node": "^25.0.1",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.15"
  }
}
